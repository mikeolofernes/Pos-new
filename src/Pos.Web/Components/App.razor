<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0f172a" />
    <title>POS</title>
    <base href="/" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="icon" href="favicon.ico" />

    <!-- Bootstrap (grid + utility classes) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- MudBlazor + Roboto -->
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />

    <!-- App styles (Bootstrap utility overrides for POS layout) -->
    <link rel="stylesheet" href="_content/Pos.Web.Client/css/app.css" />
    <link href="Pos.Web.Client.styles.css" rel="stylesheet" />
    <HeadOutlet @rendermode="@WasmNoPrerender" />
</head>
<body>
    <Routes @rendermode="@WasmNoPrerender" />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
      Blazor.start().then(() => {
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.register('/service-worker.js');
        }
      });
    </script>
</body>
</html>

@code {
    // Disable prerendering so client-only services (AuthState, IndexedDb, etc.)
    // are never resolved server-side during a prerender pass.
    private static readonly InteractiveWebAssemblyRenderMode WasmNoPrerender = new(prerender: false);
}
