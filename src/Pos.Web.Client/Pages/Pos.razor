@page "/pos"
@implements IDisposable
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject OfflineOutbox Outbox
@inject IndexedDbInterop Idb
@inject IJSRuntime JS

<PageTitle>POS</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <div class="p-4">Redirecting…</div>
    return;
}

<div class="pos-layout">
    <!-- Catalog pane -->
    <section class="pos-catalog">
        <div class="pos-search">
            <input class="form-control form-control-lg" placeholder="Search or scan barcode…"
                   @bind="_search" @bind:event="oninput" @onkeydown="OnSearchKey" />
            @if (_offline)
            {
                <span class="badge bg-warning text-dark ms-2 align-self-center">Offline</span>
            }
        </div>
        @if (_loading)
        {
            <div class="p-3 text-muted">Loading catalog…</div>
        }
        else
        {
            <div class="pos-grid">
                @foreach (var p in Filtered)
                {
                    <button class="pos-tile" @onclick="() => AddToCart(p)">
                        <div class="pos-tile-name">@p.Name</div>
                        <div class="pos-tile-sku">@p.Sku</div>
                        <div class="pos-tile-price">@FormatMoney(p.Price, p.Currency)</div>
                    </button>
                }
                @if (Filtered.Count == 0)
                {
                    <div class="p-3 text-muted">No products match.</div>
                }
            </div>
        }
    </section>

    <!-- Cart pane -->
    <aside class="pos-cart">
        <header class="pos-cart-head">
            <h2 class="h5 mb-0">Cart</h2>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearCart" disabled="@(_cart.Count == 0)">Clear</button>
        </header>

        <div class="pos-cart-lines">
            @foreach (var (line, idx) in _cart.Select((l, i) => (l, i)))
            {
                <div class="pos-line">
                    <div class="pos-line-main">
                        <div class="fw-semibold">@line.Product.Name</div>
                        <div class="text-muted small">@FormatMoney(line.UnitPrice, line.Currency) ea</div>
                    </div>
                    <div class="pos-line-qty">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ChangeQty(idx, -1)">−</button>
                        <span class="mx-2 fw-semibold">@line.Quantity</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ChangeQty(idx, 1)">+</button>
                    </div>
                    <div class="pos-line-total">@FormatMoney(line.Quantity * line.UnitPrice, line.Currency)</div>
                </div>
            }
            @if (_cart.Count == 0)
            {
                <div class="p-3 text-muted">Tap a product to add it.</div>
            }
        </div>

        <footer class="pos-cart-foot">
            <div class="d-flex justify-content-between"><span>Subtotal</span><span>@FormatMoney(Subtotal, Currency)</span></div>
            <div class="d-flex justify-content-between text-muted small"><span>Tax (estimated)</span><span>@FormatMoney(EstimatedTax, Currency)</span></div>
            <div class="d-flex justify-content-between fs-4 fw-bold border-top pt-2 mt-2">
                <span>Total</span><span>@FormatMoney(Total, Currency)</span>
            </div>
            <button class="btn btn-primary btn-lg w-100 mt-3" disabled="@(_cart.Count == 0 || _busy)" @onclick="OpenTender">
                @(_busy ? "Processing…" : "Charge")
            </button>
            @if (_pendingOutbox > 0)
            {
                <div class="small text-muted mt-2">@_pendingOutbox queued · <a href="#" @onclick:preventDefault @onclick="Drain">Sync now</a></div>
            }
            @if (_error is not null)
            {
                <div class="alert alert-danger py-2 mt-2 mb-0">@_error</div>
            }
        </footer>
    </aside>
</div>

@if (_showTender)
{
    <div class="modal-overlay" @onclick="() => _showTender = false">
        <div class="modal-card" @onclick:stopPropagation>
            <h3 class="h5">Tender @FormatMoney(Total, Currency)</h3>
            <div class="mb-3">
                <label class="form-label">Method</label>
                <select class="form-select form-select-lg" @bind="_tenderMethod">
                    <option value="cash">Cash</option>
                    <option value="card">Card</option>
                    <option value="wallet">Wallet</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Amount tendered</label>
                <input type="number" step="0.01" class="form-control form-control-lg"
                       @bind="_tenderAmount" />
            </div>
            <div class="d-flex justify-content-between mb-3">
                <span>Change due</span>
                <strong>@FormatMoney(Math.Max(0, _tenderAmount - Total), Currency)</strong>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary flex-fill" @onclick="() => _showTender = false">Cancel</button>
                <button class="btn btn-primary flex-fill" disabled="@(_tenderAmount < Total)" @onclick="Commit">Complete</button>
            </div>
        </div>
    </div>
}

@if (_lastReceipt is not null)
{
    <div class="modal-overlay" @onclick="() => _lastReceipt = null">
        <div class="modal-card text-center" @onclick:stopPropagation>
            <div class="display-6">✓</div>
            <div class="fw-bold">Sale @_lastReceipt.Number</div>
            <div class="text-muted mb-3">@FormatMoney(_lastReceipt.Total, Currency) · change @FormatMoney(_lastReceipt.Change, Currency)</div>
            <button class="btn btn-primary w-100" @onclick="() => _lastReceipt = null">New sale</button>
        </div>
    </div>
}

@code {
    private sealed record Line(ProductDto Product, decimal Quantity, decimal UnitPrice, string Currency);

    private List<ProductDto> _products = new();
    private readonly List<Line> _cart = new();
    private string _search = "";
    private bool _loading = true;
    private bool _busy;
    private bool _offline;
    private bool _showTender;
    private string _tenderMethod = "cash";
    private decimal _tenderAmount;
    private string? _error;
    private SaleSummary? _lastReceipt;
    private int _pendingOutbox;

    // Demo values - in production resolve from shop/register/shift selector
    private Guid _shopId, _registerId, _shiftId, _warehouseId;

    private List<ProductDto> Filtered =>
        string.IsNullOrWhiteSpace(_search)
            ? _products
            : _products.Where(p =>
                p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                p.Sku.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();

    private decimal Subtotal => _cart.Sum(l => l.Quantity * l.UnitPrice);
    private decimal EstimatedTax => Math.Round(Subtotal * 0.0875m, 2);   // server-authoritative; UI hint only
    private decimal Total => Subtotal + EstimatedTax;
    private string Currency => _cart.FirstOrDefault()?.Currency ?? "USD";

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadAsync();
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login", true); return; }

        _offline = !await IsOnlineAsync();
        await LoadCatalog();
        _pendingOutbox = await Outbox.PendingCountAsync();
        _loading = false;
    }

    private async Task<bool> IsOnlineAsync()
    {
        try { return await JS.InvokeAsync<bool>("navigator.onLine"); }
        catch { return true; }
    }

    private async Task LoadCatalog()
    {
        try
        {
            var page = await Api.ListProductsAsync(pageSize: 200);
            if (page is not null)
            {
                _products = page.Items.Where(p => p.IsActive).ToList();
                await Idb.PutAsync("catalog", "all", _products);
            }
            var shops = await Api.ListShopsAsync();
            if (shops.Count > 0)
            {
                _shopId = shops[0].Id;
                // The demo seed creates one register + one warehouse named WH-MAIN — keep local
                // shift handling minimal: if you need to handle shifts properly, redirect to a
                // shift-open screen first. We'll mint placeholder GUIDs for the demo so the UI
                // renders; CommitSaleAsync will surface a clear error if the shift isn't open.
                _registerId = Guid.NewGuid();
                _shiftId = Guid.NewGuid();
                _warehouseId = Guid.NewGuid();
            }
        }
        catch
        {
            _offline = true;
            _products = (await Idb.GetAsync<List<ProductDto>>("catalog", "all")) ?? new();
        }
    }

    private void AddToCart(ProductDto p)
    {
        var idx = _cart.FindIndex(l => l.Product.Id == p.Id);
        if (idx >= 0) _cart[idx] = _cart[idx] with { Quantity = _cart[idx].Quantity + 1 };
        else _cart.Add(new Line(p, 1, p.Price, p.Currency));
    }

    private void ChangeQty(int idx, int delta)
    {
        var newQty = _cart[idx].Quantity + delta;
        if (newQty <= 0) _cart.RemoveAt(idx);
        else _cart[idx] = _cart[idx] with { Quantity = newQty };
    }

    private void ClearCart() { _cart.Clear(); _error = null; }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && Filtered.Count == 1)
        {
            AddToCart(Filtered[0]);
            _search = "";
        }
        await Task.CompletedTask;
    }

    private void OpenTender()
    {
        _tenderAmount = Total;
        _tenderMethod = "cash";
        _showTender = true;
    }

    private async Task Commit()
    {
        _busy = true; _error = null;
        try
        {
            var req = new CreateSaleRequest(
                ShopId: _shopId, RegisterId: _registerId, ShiftId: _shiftId, WarehouseId: _warehouseId,
                CustomerId: null, Currency: Currency,
                Items: _cart.Select(l => new SaleLineRequest(l.Product.Id, null, l.Quantity, l.UnitPrice, 0m)).ToList(),
                Payments: new[] { new SalePaymentRequest(_tenderMethod, _tenderAmount, null) },
                Notes: null, ClientCompletedAt: DateTimeOffset.UtcNow);

            var idem = Guid.NewGuid().ToString("N");

            if (_offline)
            {
                await Outbox.EnqueueAsync("sale", "create", req);
                _pendingOutbox = await Outbox.PendingCountAsync();
                _lastReceipt = new SaleSummary(Guid.NewGuid(), "OFFLINE-" + idem[..6],
                    Subtotal, 0, EstimatedTax, Total, _tenderAmount, _tenderAmount - Total,
                    "Queued", DateTimeOffset.UtcNow);
            }
            else
            {
                var resp = await Api.CommitSaleAsync(req, idem);
                if (!resp.IsSuccessStatusCode)
                {
                    _error = $"Server rejected sale: {(int)resp.StatusCode}";
                    return;
                }
                _lastReceipt = await resp.Content.ReadFromJsonAsync<SaleSummary>();
            }

            _cart.Clear();
            _showTender = false;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Drain()
    {
        var auth = Auth.Current; if (auth is null) return;
        // device id: derive a stable per-tab id; in production persist this
        var deviceId = Guid.NewGuid();
        await Outbox.DrainAsync(deviceId);
        _pendingOutbox = await Outbox.PendingCountAsync();
    }

    private static string FormatMoney(decimal amount, string currency) =>
        $"{currency} {amount:0.00}";

    public void Dispose() { }
}
