@page "/shops"
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Shops</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5">Shops</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Variant="Variant.Filled" Color="Color.Primary"
               Disabled="@(!Auth.Has("shops.write"))"
               OnClick="OpenCreate">New shop</MudButton>
</MudStack>

<MudTable Items="_items" Loading="_loading" Hover="true" Dense="true"
          Breakpoint="Breakpoint.Sm" Class="mud-elevation-1">
    <HeaderContent>
        <MudTh>Code</MudTh>
        <MudTh>Name</MudTh>
        <MudTh>Currency</MudTh>
        <MudTh>Time zone</MudTh>
        <MudTh>Active</MudTh>
        <MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Code"><code>@context.Code</code></MudTd>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Currency">@context.Currency</MudTd>
        <MudTd DataLabel="Time zone">@context.TimeZoneId</MudTd>
        <MudTd DataLabel="Active">
            @if (context.IsActive)
            { <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" /> }
            else
            { <MudIcon Icon="@Icons.Material.Filled.RemoveCircleOutline" Color="Color.Default" Size="Size.Small" /> }
        </MudTd>
        <MudTd Style="text-align:right">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                           Disabled="@(!Auth.Has("shops.write"))"
                           OnClick="@(() => OpenEdit(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           Disabled="@(!Auth.Has("shops.write"))"
                           OnClick="@(() => Delete(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>No shops yet.</MudText></NoRecordsContent>
</MudTable>

@code {
    private List<ShopDto> _items = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadAsync();
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login", true); return; }
        await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        _items = (await Api.ListShopsAsync()).ToList();
        _loading = false;
    }

    private async Task OpenCreate()
    {
        var dialog = await Dialogs.ShowAsync<ShopDialog>("New shop",
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        if (result?.Canceled is false && result.Data is CreateShopRequest body)
        {
            var s = await Api.CreateShopAsync(body);
            if (s is null) { Snackbar.Add("Could not create shop (duplicate code?)", Severity.Error); return; }
            Snackbar.Add($"Created {s.Code}", Severity.Success);
            await Reload();
        }
    }

    private async Task OpenEdit(ShopDto s)
    {
        var parameters = new DialogParameters<ShopDialog> { { x => x.Existing, s } };
        var dialog = await Dialogs.ShowAsync<ShopDialog>("Edit shop", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        if (result?.Canceled is false && result.Data is UpdateShopRequest body)
        {
            var u = await Api.UpdateShopAsync(s.Id, body);
            if (u is null) { Snackbar.Add("Update failed", Severity.Error); return; }
            Snackbar.Add("Saved", Severity.Success);
            await Reload();
        }
    }

    private async Task Delete(ShopDto s)
    {
        var ok = await Dialogs.ShowMessageBox("Delete shop",
            $"Delete '{s.Name}'? This cannot be undone.", yesText: "Delete", cancelText: "Cancel");
        if (ok is not true) return;
        if (await Api.DeleteShopAsync(s.Id))
        {
            Snackbar.Add("Deleted", Severity.Info);
            await Reload();
        }
        else Snackbar.Add("Delete failed", Severity.Error);
    }
}
