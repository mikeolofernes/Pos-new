@page "/shifts"
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Shifts</PageTitle>

<div class="page-head">
    <h1 class="h3">Shifts</h1>
</div>

<div class="row g-3">
    <div class="col-12 col-md-6">
        <div class="card">
            <div class="card-body">
                <h2 class="h5">Open shift</h2>
                <div class="mb-2"><label class="form-label">Register Id</label>
                    <input class="form-control" @bind="_registerId" /></div>
                <div class="mb-3"><label class="form-label">Opening float</label>
                    <input type="number" step="0.01" class="form-control" @bind="_openingFloat" /></div>
                <button class="btn btn-primary w-100" @onclick="Open" disabled="@_busy">Open shift</button>
                @if (_openMsg is not null) { <div class="mt-3 alert alert-info py-2">@_openMsg</div> }
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="card">
            <div class="card-body">
                <h2 class="h5">Close shift</h2>
                <div class="mb-2"><label class="form-label">Shift Id</label>
                    <input class="form-control" @bind="_closeShiftId" /></div>
                <div class="mb-3"><label class="form-label">Closing declared (cash)</label>
                    <input type="number" step="0.01" class="form-control" @bind="_closingDeclared" /></div>
                <button class="btn btn-primary w-100" @onclick="Close" disabled="@_busy">Close shift</button>
                @if (_closeMsg is not null) { <div class="mt-3 alert alert-info py-2">@_closeMsg</div> }
            </div>
        </div>
    </div>
</div>

@code {
    private string _registerId = "";
    private decimal _openingFloat;
    private string _closeShiftId = "";
    private decimal _closingDeclared;
    private string? _openMsg;
    private string? _closeMsg;
    private bool _busy;
    private Guid _shopId;

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadAsync();
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login", true); return; }
        var shops = await Api.ListShopsAsync();
        if (shops.Count > 0) _shopId = shops[0].Id;
    }

    private async Task Open()
    {
        _busy = true; _openMsg = null;
        try
        {
            if (!Guid.TryParse(_registerId, out var rid)) { _openMsg = "Invalid register id"; return; }
            var id = await Api.OpenShiftAsync(new OpenShiftRequest(_shopId, rid, _openingFloat));
            _openMsg = id is null ? "Failed (already open?)" : $"Opened shift {id}";
        }
        finally { _busy = false; }
    }

    private async Task Close()
    {
        _busy = true; _closeMsg = null;
        try
        {
            if (!Guid.TryParse(_closeShiftId, out var sid)) { _closeMsg = "Invalid shift id"; return; }
            var r = await Api.CloseShiftAsync(sid, _closingDeclared);
            _closeMsg = r is null ? "Failed" : $"Expected {r.Expected:0.00}, declared {r.Declared:0.00}, variance {r.Variance:0.00}";
        }
        finally { _busy = false; }
    }
}
