@page "/shifts"
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Shifts</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Shifts</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent><MudText Typo="Typo.h6">Open shift</MudText></CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudTextField @bind-Value="_registerId" Label="Register Id" Variant="Variant.Outlined" Class="mb-3" />
                <MudNumericField @bind-Value="_openingFloat" Label="Opening float"
                                 Variant="Variant.Outlined" Format="N2" Min="0" />
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" OnClick="Open" Disabled="@_busy">Open shift</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent><MudText Typo="Typo.h6">Close shift</MudText></CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudTextField @bind-Value="_closeShiftId" Label="Shift Id" Variant="Variant.Outlined" Class="mb-3" />
                <MudNumericField @bind-Value="_closingDeclared" Label="Closing declared (cash)"
                                 Variant="Variant.Outlined" Format="N2" Min="0" />
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           FullWidth="true" OnClick="Close" Disabled="@_busy">Close shift</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private string _registerId = "";
    private decimal _openingFloat;
    private string _closeShiftId = "";
    private decimal _closingDeclared;
    private bool _busy;
    private Guid _shopId;

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadAsync();
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login", true); return; }
        var shops = await Api.ListShopsAsync();
        if (shops.Count > 0) _shopId = shops[0].Id;
    }

    private async Task Open()
    {
        _busy = true;
        try
        {
            if (!Guid.TryParse(_registerId, out var rid)) { Snackbar.Add("Invalid register id", Severity.Warning); return; }
            var id = await Api.OpenShiftAsync(new OpenShiftRequest(_shopId, rid, _openingFloat));
            if (id is null) Snackbar.Add("Failed (already open?)", Severity.Error);
            else Snackbar.Add($"Opened shift {id}", Severity.Success);
        }
        finally { _busy = false; }
    }

    private async Task Close()
    {
        _busy = true;
        try
        {
            if (!Guid.TryParse(_closeShiftId, out var sid)) { Snackbar.Add("Invalid shift id", Severity.Warning); return; }
            var r = await Api.CloseShiftAsync(sid, _closingDeclared);
            if (r is null) Snackbar.Add("Failed", Severity.Error);
            else Snackbar.Add($"Expected {r.Expected:0.00}, declared {r.Declared:0.00}, variance {r.Variance:0.00}",
                              r.Variance == 0 ? Severity.Success : Severity.Warning);
        }
        finally { _busy = false; }
    }
}
