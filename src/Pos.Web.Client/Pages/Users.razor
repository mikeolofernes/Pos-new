@page "/users"
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Users</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5">Users</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Variant="Variant.Filled" Color="Color.Primary"
               Disabled="@(!Auth.Has("users.manage"))"
               OnClick="OpenCreate">New user</MudButton>
</MudStack>

<MudTextField @bind-Value="_search" @bind-Value:after="Reload"
              Immediate="true" DebounceInterval="300"
              Placeholder="Search by email or name…"
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
              Variant="Variant.Outlined" Margin="Margin.Dense"
              Class="mb-3" />

<MudTable Items="_items" Loading="_loading" Hover="true" Dense="true"
          Breakpoint="Breakpoint.Sm" Class="mud-elevation-1">
    <HeaderContent>
        <MudTh>Email</MudTh>
        <MudTh>Name</MudTh>
        <MudTh>Phone</MudTh>
        <MudTh>Active</MudTh>
        <MudTh>Last login</MudTh>
        <MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Email">@context.Email</MudTd>
        <MudTd DataLabel="Name">@context.DisplayName</MudTd>
        <MudTd DataLabel="Phone">@context.Phone</MudTd>
        <MudTd DataLabel="Active">
            @if (context.IsActive)
            { <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" /> }
            else
            { <MudIcon Icon="@Icons.Material.Filled.RemoveCircleOutline" Color="Color.Default" Size="Size.Small" /> }
        </MudTd>
        <MudTd DataLabel="Last login">@(context.LastLoginAt?.LocalDateTime.ToString("g") ?? "—")</MudTd>
        <MudTd Style="text-align:right">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                           Disabled="@(!Auth.Has("users.manage"))"
                           OnClick="@(() => OpenEdit(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           Disabled="@(!Auth.Has("users.manage"))"
                           OnClick="@(() => Delete(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>No users found.</MudText></NoRecordsContent>
</MudTable>

@code {
    private List<UserDto> _items = new();
    private bool _loading = true;
    private string _search = "";

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadAsync();
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login", true); return; }
        if (!Auth.Has("users.manage")) { Nav.NavigateTo("/", true); return; }
        _shops = (await Api.ListShopsAsync()).ToList();
        await Reload();
    }

    private List<ShopDto> _shops = new();

    private async Task Reload()
    {
        _loading = true;
        _items = (await Api.ListUsersAsync(_search)).ToList();
        _loading = false;
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<UserDialog> { { x => x.Shops, _shops } };
        var dialog = await Dialogs.ShowAsync<UserDialog>("New user", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        if (result?.Canceled is false && result.Data is CreateUserRequest body)
        {
            var u = await Api.CreateUserAsync(body);
            if (u is null) { Snackbar.Add("Could not create user (duplicate email?)", Severity.Error); return; }
            Snackbar.Add($"Created {u.Email}", Severity.Success);
            await Reload();
        }
    }

    private async Task OpenEdit(UserDto u)
    {
        var parameters = new DialogParameters<UserDialog>
        {
            { x => x.Existing, u },
            { x => x.Shops, _shops }
        };
        var dialog = await Dialogs.ShowAsync<UserDialog>("Edit user", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        if (result?.Canceled is false && result.Data is UpdateUserRequest body)
        {
            var ru = await Api.UpdateUserAsync(u.Id, body);
            if (ru is null) { Snackbar.Add("Update failed", Severity.Error); return; }
            Snackbar.Add("Saved", Severity.Success);
            await Reload();
        }
    }

    private async Task Delete(UserDto u)
    {
        var ok = await Dialogs.ShowMessageBox("Delete user",
            $"Delete '{u.Email}'? This cannot be undone.", yesText: "Delete", cancelText: "Cancel");
        if (ok is not true) return;
        if (await Api.DeleteUserAsync(u.Id))
        {
            Snackbar.Add("Deleted", Severity.Info);
            await Reload();
        }
        else Snackbar.Add("Delete failed", Severity.Error);
    }
}
