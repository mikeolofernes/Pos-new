@page "/inventory"
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Inventory</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Inventory</MudText>

<MudTextField @bind-Value="_search" @bind-Value:after="Reload"
              Immediate="true" DebounceInterval="300"
              Placeholder="Search products…"
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
              Variant="Variant.Outlined" Margin="Margin.Dense"
              Class="mb-3" />

<MudTable Items="_rows" Loading="_loading" Hover="true" Dense="true"
          Breakpoint="Breakpoint.Sm" Class="mud-elevation-1">
    <HeaderContent>
        <MudTh>SKU</MudTh>
        <MudTh>Name</MudTh>
        <MudTh Style="text-align:right">On hand</MudTh>
        <MudTh Style="text-align:right">Avg cost</MudTh>
        <MudTh />
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="SKU"><code>@context.Product.Sku</code></MudTd>
        <MudTd DataLabel="Name">@context.Product.Name</MudTd>
        <MudTd DataLabel="On hand" Style="text-align:right">@context.OnHand.ToString("0.###")</MudTd>
        <MudTd DataLabel="Avg cost" Style="text-align:right">@context.AverageCost.ToString("0.00")</MudTd>
        <MudTd Style="text-align:right">
            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Tune"
                       Disabled="@(!Auth.Has("inventory.write"))"
                       OnClick="@(() => StartAdjust(context.Product))">Adjust</MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>No items.</MudText></NoRecordsContent>
</MudTable>

@code {
    private sealed record Row(ProductDto Product, decimal OnHand, decimal AverageCost);

    private List<Row> _rows = new();
    private bool _loading = true;
    private string _search = "";
    private Guid _shopId, _warehouseId;

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadAsync();
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login", true); return; }
        var shops = await Api.ListShopsAsync();
        if (shops.Count > 0) _shopId = shops[0].Id;
        await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        var page = await Api.ListProductsAsync(_search, 1, 200);
        var rows = new List<Row>();
        foreach (var p in page?.Items ?? Array.Empty<ProductDto>())
        {
            var bals = await Api.GetBalanceAsync(p.Id);
            var b = bals.FirstOrDefault();
            rows.Add(new Row(p, b?.OnHand ?? 0, b?.AverageCost ?? 0));
            if (b is not null) _warehouseId = b.WarehouseId;
        }
        _rows = rows;
        _loading = false;
    }

    private async Task StartAdjust(ProductDto p)
    {
        var parameters = new DialogParameters<AdjustStockDialog>
        {
            { x => x.ProductName, p.Name }
        };
        var dialog = await Dialogs.ShowAsync<AdjustStockDialog>("Adjust stock", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraSmall });
        var result = await dialog.Result;
        if (result?.Canceled is false && result.Data is AdjustStockDialog.AdjustResult a)
        {
            var idem = Guid.NewGuid().ToString("N");
            var resp = await Api.AdjustStockAsync(new AdjustStockRequest(
                _shopId, _warehouseId, p.Id, null, a.Delta, a.UnitCost, a.Reason), idem);
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add($"Server rejected ({(int)resp.StatusCode})", Severity.Error);
                return;
            }
            Snackbar.Add("Stock adjusted", Severity.Success);
            await Reload();
        }
    }
}
