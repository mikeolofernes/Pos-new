@page "/inventory"
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Inventory</PageTitle>

<div class="page-head">
    <h1 class="h3">Inventory</h1>
</div>

<div class="row g-2 mb-3">
    <div class="col">
        <input class="form-control" placeholder="Search products…" @bind="_search" @bind:event="oninput" @bind:after="Reload" />
    </div>
</div>

@if (_loading)
{
    <div>Loading…</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light">
                <tr><th>SKU</th><th>Name</th><th class="text-end">On hand</th><th class="text-end">Avg cost</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td><code>@row.Product.Sku</code></td>
                        <td>@row.Product.Name</td>
                        <td class="text-end">@row.OnHand.ToString("0.###")</td>
                        <td class="text-end">@row.AverageCost.ToString("0.00")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary"
                                    disabled="@(!Auth.Has("inventory.write"))"
                                    @onclick="() => StartAdjust(row.Product)">Adjust</button>
                        </td>
                    </tr>
                }
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="5" class="text-muted text-center py-4">No items.</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_adjusting is not null)
{
    <div class="modal-overlay" @onclick="() => _adjusting = null">
        <div class="modal-card" @onclick:stopPropagation>
            <h3 class="h5">Adjust @_adjusting.Name</h3>
            <div class="mb-2"><label class="form-label">Quantity delta (negative to reduce)</label>
                <input type="number" step="0.001" class="form-control" @bind="_delta" /></div>
            <div class="mb-3"><label class="form-label">Unit cost</label>
                <input type="number" step="0.01" class="form-control" @bind="_cost" /></div>
            @if (_adjustError is not null) { <div class="alert alert-danger py-2">@_adjustError</div> }
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary flex-fill" @onclick="() => _adjusting = null">Cancel</button>
                <button class="btn btn-primary flex-fill" @onclick="Commit">Apply</button>
            </div>
        </div>
    </div>
}

@code {
    private sealed record Row(ProductDto Product, decimal OnHand, decimal AverageCost);

    private List<Row> _rows = new();
    private bool _loading = true;
    private string _search = "";
    private ProductDto? _adjusting;
    private decimal _delta;
    private decimal _cost;
    private string? _adjustError;
    private Guid _shopId, _warehouseId;

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadAsync();
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login", true); return; }
        var shops = await Api.ListShopsAsync();
        if (shops.Count > 0) _shopId = shops[0].Id;
        await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        var page = await Api.ListProductsAsync(_search, 1, 200);
        var rows = new List<Row>();
        foreach (var p in page?.Items ?? Array.Empty<ProductDto>())
        {
            var bals = await Api.GetBalanceAsync(p.Id);
            var b = bals.FirstOrDefault();
            rows.Add(new Row(p, b?.OnHand ?? 0, b?.AverageCost ?? 0));
            if (b is not null) _warehouseId = b.WarehouseId;
        }
        _rows = rows;
        _loading = false;
    }

    private void StartAdjust(ProductDto p) { _adjusting = p; _delta = 0; _cost = 0; _adjustError = null; }

    private async Task Commit()
    {
        if (_adjusting is null) return;
        _adjustError = null;
        try
        {
            var idem = Guid.NewGuid().ToString("N");
            var resp = await Api.AdjustStockAsync(new AdjustStockRequest(
                _shopId, _warehouseId, _adjusting.Id, null, _delta, _cost, "Manual"), idem);
            if (!resp.IsSuccessStatusCode) { _adjustError = $"Server rejected ({(int)resp.StatusCode})"; return; }
            _adjusting = null;
            await Reload();
        }
        catch (Exception ex) { _adjustError = ex.Message; }
    }
}
