@page "/products"
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Products</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5">Products</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Variant="Variant.Filled" Color="Color.Primary"
               Disabled="@(!Auth.Has("products.write"))"
               OnClick="OpenCreate">New</MudButton>
</MudStack>

<MudTextField @bind-Value="_search" @bind-Value:after="Reload"
              Immediate="true" DebounceInterval="300"
              Placeholder="Search by name or SKU…"
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
              Variant="Variant.Outlined" Margin="Margin.Dense"
              Class="mb-3" />

<MudTable Items="_items" Loading="_loading" Hover="true" Dense="true"
          Breakpoint="Breakpoint.Sm" Class="mud-elevation-1">
    <HeaderContent>
        <MudTh>SKU</MudTh>
        <MudTh>Name</MudTh>
        <MudTh>Category</MudTh>
        <MudTh Style="text-align:right">Price</MudTh>
        <MudTh>Tax</MudTh>
        <MudTh>Active</MudTh>
        <MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="SKU"><code>@context.Sku</code></MudTd>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Category">@CategoryName(context.CategoryId)</MudTd>
        <MudTd DataLabel="Price" Style="text-align:right">@context.Currency @context.Price.ToString("0.00")</MudTd>
        <MudTd DataLabel="Tax">@context.TaxCode</MudTd>
        <MudTd DataLabel="Active">
            @if (context.IsActive)
            { <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" /> }
            else
            { <MudIcon Icon="@Icons.Material.Filled.RemoveCircleOutline" Color="Color.Default" Size="Size.Small" /> }
        </MudTd>
        <MudTd Style="text-align:right">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                           Disabled="@(!Auth.Has("products.write"))"
                           OnClick="@(() => OpenEdit(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           Disabled="@(!Auth.Has("products.write"))"
                           OnClick="@(() => Delete(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>No products found.</MudText></NoRecordsContent>
</MudTable>

@code {
    private List<ProductDto> _items = new();
    private List<CategoryDto> _categories = new();
    private bool _loading = true;
    private string _search = "";

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadAsync();
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login", true); return; }
        _categories = (await Api.ListCategoriesAsync()).ToList();
        await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        var page = await Api.ListProductsAsync(_search, 1, 200);
        _items = page?.Items.ToList() ?? new();
        _loading = false;
    }

    private string CategoryName(Guid? id) => id is null
        ? "—"
        : (_categories.FirstOrDefault(c => c.Id == id)?.Name ?? "—");

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<ProductDialog> { { x => x.Categories, _categories } };
        var dialog = await Dialogs.ShowAsync<ProductDialog>("New product", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        if (result?.Canceled is false && result.Data is CreateProductRequest body)
        {
            var p = await Api.CreateProductAsync(body);
            if (p is null) { Snackbar.Add("Could not create product (duplicate SKU?)", Severity.Error); return; }
            Snackbar.Add($"Created {p.Sku}", Severity.Success);
            await Reload();
        }
    }

    private async Task OpenEdit(ProductDto p)
    {
        var parameters = new DialogParameters<ProductDialog>
        {
            { x => x.Existing, p },
            { x => x.Categories, _categories }
        };
        var dialog = await Dialogs.ShowAsync<ProductDialog>("Edit product", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        if (result?.Canceled is false && result.Data is UpdateProductRequest body)
        {
            var u = await Api.UpdateProductAsync(p.Id, body);
            if (u is null) { Snackbar.Add("Update failed", Severity.Error); return; }
            Snackbar.Add("Saved", Severity.Success);
            await Reload();
        }
    }

    private async Task Delete(ProductDto p)
    {
        var ok = await Dialogs.ShowMessageBox("Delete product",
            $"Delete '{p.Name}'? This cannot be undone.", yesText: "Delete", cancelText: "Cancel");
        if (ok is not true) return;
        if (await Api.DeleteProductAsync(p.Id))
        {
            Snackbar.Add("Deleted", Severity.Info);
            await Reload();
        }
        else Snackbar.Add("Delete failed", Severity.Error);
    }
}
