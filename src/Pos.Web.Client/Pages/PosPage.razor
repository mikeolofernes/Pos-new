@page "/pos"
@implements IDisposable
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject OfflineOutbox Outbox
@inject IndexedDbInterop Idb
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>POS</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <MudText>Redirecting…</MudText>
    return;
}

<MudGrid Spacing="2" Class="pos-grid-root">
    <!-- Catalog pane -->
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-3 pos-pane" Elevation="1">
            <MudTextField @bind-Value="_search" @bind-Value:after="StateHasChanged"
                          Immediate="true"
                          Placeholder="Search or scan barcode…"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyDown="OnSearchKey"
                          Class="mb-3" />

            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (string.IsNullOrWhiteSpace(_search))
            {
                @* Default view: shortcut tiles (image-first, big touch targets) *@
                <div class="pos-tiles">
                    @foreach (var q in _quickSelects)
                    {
                        <MudPaper Class="pos-tile pos-tile-image pa-0" Elevation="0" Outlined="true"
                                  Style="@TileStyle(q.Color)"
                                  @onclick="() => AddToCartById(q.ProductId)">
                            <div class="pos-tile-img">
                                @if (!string.IsNullOrEmpty(q.ImageUrl))
                                {
                                    <img src="@q.ImageUrl" alt="@q.ProductName" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Color="Color.Default" />
                                }
                            </div>
                            <div class="pos-tile-body pa-2">
                                <MudText Typo="Typo.subtitle2" Class="text-truncate">@(q.Label ?? q.ProductName)</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Primary">@FormatMoney(q.Price, q.Currency)</MudText>
                            </div>
                        </MudPaper>
                    }
                    @if (_quickSelects.Count == 0)
                    {
                        <MudText Class="text-muted pa-3">
                            No shortcuts yet. Pin products on the
                            <MudLink Href="/quick-selects">Quick selects</MudLink> page,
                            or search above to find any product.
                        </MudText>
                    }
                </div>
            }
            else
            {
                @* Search active: show full product results *@
                <div class="pos-tiles">
                    @foreach (var p in Filtered)
                    {
                        <MudPaper Class="pos-tile pos-tile-image pa-0" Elevation="0" Outlined="true"
                                  @onclick="() => AddToCart(p)">
                            <div class="pos-tile-img">
                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                {
                                    <img src="@p.ImageUrl" alt="@p.Name" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Color="Color.Default" />
                                }
                            </div>
                            <div class="pos-tile-body pa-2">
                                <MudText Typo="Typo.subtitle2" Class="text-truncate">@p.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default" Class="text-muted">@p.Sku</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Primary">@FormatMoney(p.Price, p.Currency)</MudText>
                            </div>
                        </MudPaper>
                    }
                    @if (Filtered.Count == 0)
                    {
                        <MudText Class="text-muted pa-3">No products match.</MudText>
                    }
                </div>
            }
        </MudPaper>
    </MudItem>

    <!-- Cart pane -->
    <MudItem xs="12" md="4">
        <MudPaper Class="pos-pane d-flex flex-column" Elevation="1">
            <div class="d-flex align-items-center pa-3 border-bottom">
                <MudText Typo="Typo.h6">Cart</MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                           Disabled="@(_cart.Count == 0)" OnClick="ClearCart">Clear</MudButton>
            </div>

            <MudList T="object" Dense="true" Class="flex-grow-1 pos-cart-list">
                @foreach (var (line, idx) in _cart.Select((l, i) => (l, i)))
                {
                    <MudListItem T="object">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <MudText Typo="Typo.body2" Class="fw-semibold">@line.Product.Name</MudText>
                                <MudText Typo="Typo.caption" Class="text-muted">@FormatMoney(line.UnitPrice, line.Currency) ea</MudText>
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small"
                                           OnClick="@(() => ChangeQty(idx, -1))" />
                            <MudText Class="mx-2 fw-bold">@line.Quantity</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => ChangeQty(idx, 1))" />
                            <MudText Class="ms-3" Style="min-width:80px;text-align:right;">
                                @FormatMoney(line.Quantity * line.UnitPrice, line.Currency)
                            </MudText>
                        </div>
                    </MudListItem>
                }
                @if (_cart.Count == 0)
                {
                    <MudListItem T="object">
                        <MudText Class="text-muted">Tap a product to add it.</MudText>
                    </MudListItem>
                }
            </MudList>

            <div class="pa-3 border-top" style="background:#fafbfc">
                <div class="d-flex justify-content-between">
                    <MudText Typo="Typo.h6">Total</MudText>
                    <MudText Typo="Typo.h6">@FormatMoney(Total, Currency)</MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           FullWidth="true" Class="mt-3"
                           Disabled="@(_cart.Count == 0 || _busy)"
                           OnClick="OpenTender">
                    @if (_busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" /> }
                    Charge
                </MudButton>
                @if (_pendingOutbox > 0)
                {
                    <div class="text-center mt-2">
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Sync"
                                 OnClick="Drain">@_pendingOutbox queued — sync now</MudChip>
                    </div>
                }
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private sealed record Line(ProductDto Product, decimal Quantity, decimal UnitPrice, string Currency);

    private List<ProductDto> _products = new();
    private List<QuickSelectDto> _quickSelects = new();
    private readonly List<Line> _cart = new();
    private string _search = "";
    private bool _loading = true;
    private bool _busy;
    private bool _offline;
    private int _pendingOutbox;

    private Guid _shopId, _registerId, _shiftId, _warehouseId;

    private List<ProductDto> Filtered =>
        string.IsNullOrWhiteSpace(_search)
            ? _products
            : _products.Where(p =>
                p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                p.Sku.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();

    // Prices are tax-inclusive (SRP), so the cart total is just the sum of lines.
    private decimal Subtotal => _cart.Sum(l => l.Quantity * l.UnitPrice);
    private decimal Total => Subtotal;
    private string Currency => _cart.FirstOrDefault()?.Currency ?? "USD";

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadAsync();
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login", true); return; }

        _offline = !await IsOnlineAsync();
        await LoadCatalog();
        _pendingOutbox = await Outbox.PendingCountAsync();
        _loading = false;
    }

    private async Task<bool> IsOnlineAsync()
    {
        try { return await JS.InvokeAsync<bool>("navigator.onLine"); }
        catch { return true; }
    }

    private async Task LoadCatalog()
    {
        try
        {
            var page = await Api.ListProductsAsync(pageSize: 200);
            if (page is not null)
            {
                _products = page.Items.Where(p => p.IsActive).ToList();
                await Idb.PutAsync("catalog", "all", _products);
            }
            try
            {
                _quickSelects = (await Api.ListQuickSelectsAsync())
                    .OrderBy(q => q.Position).ToList();
                await Idb.PutAsync("catalog", "quick", _quickSelects);
            }
            catch { /* tolerate; fall back to plain catalog */ }
            var shops = await Api.ListShopsAsync();
            if (shops.Count > 0)
            {
                _shopId = shops[0].Id;
                _registerId = Guid.NewGuid();
                _shiftId = Guid.NewGuid();
                _warehouseId = Guid.NewGuid();
            }
        }
        catch
        {
            _offline = true;
            _products = (await Idb.GetAsync<List<ProductDto>>("catalog", "all")) ?? new();
            _quickSelects = (await Idb.GetAsync<List<QuickSelectDto>>("catalog", "quick")) ?? new();
        }
    }

    private void AddToCart(ProductDto p)
    {
        var idx = _cart.FindIndex(l => l.Product.Id == p.Id);
        if (idx >= 0) _cart[idx] = _cart[idx] with { Quantity = _cart[idx].Quantity + 1 };
        else _cart.Add(new Line(p, 1, p.Price, p.Currency));
    }

    private void AddToCartById(Guid productId)
    {
        var p = _products.FirstOrDefault(x => x.Id == productId);
        if (p is not null) AddToCart(p);
    }

    private static string TileStyle(string? color) =>
        string.IsNullOrEmpty(color) ? "" : $"border-color:{color};box-shadow:inset 4px 0 0 {color}";

    private void ChangeQty(int idx, int delta)
    {
        var newQty = _cart[idx].Quantity + delta;
        if (newQty <= 0) _cart.RemoveAt(idx);
        else _cart[idx] = _cart[idx] with { Quantity = newQty };
    }

    private void ClearCart() => _cart.Clear();

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && Filtered.Count == 1)
        {
            AddToCart(Filtered[0]);
            _search = "";
        }
        await Task.CompletedTask;
    }

    private async Task OpenTender()
    {
        var parameters = new DialogParameters<TenderDialog>
        {
            { x => x.Total, Total },
            { x => x.Currency, Currency }
        };
        var opts = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await Dialogs.ShowAsync<TenderDialog>("Tender", parameters, opts);
        var result = await dialog.Result;
        if (result?.Canceled is false && result.Data is TenderDialog.TenderResult t)
            await Commit(t.Method, t.Amount);
    }

    private async Task Commit(string method, decimal tendered)
    {
        _busy = true;
        try
        {
            var req = new CreateSaleRequest(
                ShopId: _shopId, RegisterId: _registerId, ShiftId: _shiftId, WarehouseId: _warehouseId,
                CustomerId: null, Currency: Currency,
                Items: _cart.Select(l => new SaleLineRequest(l.Product.Id, null, l.Quantity, l.UnitPrice, 0m)).ToList(),
                Payments: new[] { new SalePaymentRequest(method, tendered, null) },
                Notes: null, ClientCompletedAt: DateTimeOffset.UtcNow);

            var idem = Guid.NewGuid().ToString("N");

            if (_offline)
            {
                await Outbox.EnqueueAsync("sale", "create", req);
                _pendingOutbox = await Outbox.PendingCountAsync();
                Snackbar.Add($"Sale queued offline · change {FormatMoney(tendered - Total, Currency)}", Severity.Info);
            }
            else
            {
                var resp = await Api.CommitSaleAsync(req, idem);
                if (!resp.IsSuccessStatusCode)
                {
                    Snackbar.Add($"Server rejected sale ({(int)resp.StatusCode})", Severity.Error);
                    return;
                }
                var receipt = await resp.Content.ReadFromJsonAsync<SaleSummary>();
                Snackbar.Add($"Sale {receipt?.Number} · change {FormatMoney(receipt?.Change ?? 0, Currency)}", Severity.Success);
            }

            _cart.Clear();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task Drain()
    {
        var deviceId = Guid.NewGuid();
        var n = await Outbox.DrainAsync(deviceId);
        _pendingOutbox = await Outbox.PendingCountAsync();
        Snackbar.Add($"Synced {n} item(s)", Severity.Success);
    }

    private static string FormatMoney(decimal amount, string currency) => $"{currency} {amount:0.00}";

    public void Dispose() { }
}
