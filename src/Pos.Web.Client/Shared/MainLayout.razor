@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState Auth
@inject NavigationManager Nav

<MudThemeProvider Theme="_theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (Auth.IsAuthenticated)
{
    <MudLayout>
        <MudAppBar Elevation="1" Color="Color.Dark">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                           OnClick="@(() => _drawerOpen = !_drawerOpen)" Edge="Edge.Start" />
            <MudText Typo="Typo.h6" Class="ms-2">POS</MudText>
            <MudSpacer />
            <MudText Typo="Typo.body2" Class="ms-3 d-none d-sm-inline">@Auth.Current?.DisplayName</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" />
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always"
                   Variant="@DrawerVariant.Mini" OpenMiniOnHover="true">
            <NavMenu />
        </MudDrawer>

        <MudMainContent Class="pa-3 pa-md-4">
            @Body
        </MudMainContent>
    </MudLayout>
}
else
{
    @Body
}

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2563EB",
            Secondary = "#0EA5E9",
            AppbarBackground = "#0F172A",
            DrawerBackground = "#0F172A",
            DrawerText = "#E2E8F0",
            DrawerIcon = "#E2E8F0",
            Background = "#F5F7FB",
            Surface = "#FFFFFF",
            TextPrimary = "#0F172A",
            TextSecondary = "#475569"
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "10px" }
    };

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += StateHasChanged;
        await Auth.LoadAsync();
    }

    private async Task Logout()
    {
        await Auth.ClearAsync();
        Nav.NavigateTo("/login", true);
    }

    public void Dispose() => Auth.Changed -= StateHasChanged;
}
