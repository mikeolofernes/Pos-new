@using Pos.Shared.Contracts

<MudDialog>
    <DialogContent>
        <MudAutocomplete T="ProductDto" Label="Product"
                         Value="_product" ValueChanged="OnProductChanged"
                         SearchFunc="SearchProducts"
                         ToStringFunc="@(p => p is null ? "" : $"{p.Sku} — {p.Name}")"
                         Required="true" Variant="Variant.Outlined"
                         Class="mb-3" />
        <MudSelect T="Guid?" @bind-Value="_shopId" Label="Shop (blank = all shops)"
                   Variant="Variant.Outlined" Clearable="true" Class="mb-3">
            <MudSelectItem T="Guid?" Value="@((Guid?)null)">— All shops —</MudSelectItem>
            @foreach (var s in Shops)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)s.Id)">@s.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_label" Label="Label override (optional)"
                      Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_color" Label="Tile colour (CSS, e.g. #2563EB)"
                      Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Pin</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public IReadOnlyList<ProductDto> Products { get; set; } = Array.Empty<ProductDto>();
    [Parameter] public IReadOnlyList<ShopDto> Shops { get; set; } = Array.Empty<ShopDto>();

    private ProductDto? _product;
    private Guid? _shopId;
    private string? _label;
    private string? _color;

    private Task<IEnumerable<ProductDto>> SearchProducts(string? value, CancellationToken ct)
    {
        var q = (value ?? "").Trim();
        IEnumerable<ProductDto> r = string.IsNullOrEmpty(q)
            ? Products.Take(50)
            : Products.Where(p =>
                p.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                p.Sku.Contains(q, StringComparison.OrdinalIgnoreCase)).Take(50);
        return Task.FromResult(r);
    }

    private void OnProductChanged(ProductDto? p) => _product = p;

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (_product is null) return;
        MudDialog.Close(DialogResult.Ok(new CreateQuickSelectRequest(
            _shopId, _product.Id, null,
            string.IsNullOrWhiteSpace(_label) ? null : _label.Trim(),
            string.IsNullOrWhiteSpace(_color) ? null : _color.Trim())));
    }
}
