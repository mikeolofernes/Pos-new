@using Pos.Shared.Contracts

<MudDialog>
    <DialogContent>
        @if (!_isEdit && Tenants.Count > 0)
        {
            <MudSelect T="Guid?" @bind-Value="_tenantId" Label="Tenant"
                       Variant="Variant.Outlined" Clearable="true" Class="mb-3">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">— Current tenant —</MudSelectItem>
                @foreach (var t in Tenants)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)t.Id)">@t.Name (@t.Slug)</MudSelectItem>
                }
            </MudSelect>
        }
        <MudTextField @bind-Value="_code" Label="Code" Variant="Variant.Outlined"
                      Required="true" Disabled="@(_isEdit)" Class="mb-3" />
        <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_countryCode" Label="Country" Variant="Variant.Outlined" Class="mb-3" />
        @if (_isEdit)
        {
            <MudSwitch @bind-Value="_isActive" Color="Color.Success">Active</MudSwitch>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ShopDto? Existing { get; set; }
    [Parameter] public IReadOnlyList<TenantDto> Tenants { get; set; } = Array.Empty<TenantDto>();

    private bool _isEdit;
    private Guid? _tenantId;
    private string _code = "";
    private string _name = "";
    private string _countryCode = "US";
    private bool _isActive = true;

    protected override void OnInitialized()
    {
        if (Existing is not null)
        {
            _isEdit = true;
            _code = Existing.Code;
            _name = Existing.Name;
            _isActive = Existing.IsActive;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        if (_isEdit)
        {
            MudDialog.Close(DialogResult.Ok(new UpdateShopRequest(
                _code.Trim(), _name.Trim(), _countryCode.Trim(), _isActive)));
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_code)) return;
            MudDialog.Close(DialogResult.Ok(new CreateShopRequest(
                _code.Trim(), _name.Trim(), _countryCode.Trim(), _tenantId)));
        }
    }
}
