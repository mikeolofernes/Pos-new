@using Pos.Shared.Contracts

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_slug" Label="Slug (lowercase, no spaces)"
                      Variant="Variant.Outlined" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_name" Label="Organisation name" Variant="Variant.Outlined" Required="true" Class="mb-3" />
        <MudGrid Spacing="2" Class="mb-3">
            <MudItem xs="4">
                <MudTextField @bind-Value="_country" Label="Country" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="4">
                <MudTextField @bind-Value="_currency" Label="Currency" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="4">
                <MudTextField @bind-Value="_timeZone" Label="Time zone" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">Initial admin user</MudText>
        <MudTextField @bind-Value="_adminEmail" Label="Admin email" Variant="Variant.Outlined" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_adminName" Label="Admin display name" Variant="Variant.Outlined" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_adminPassword" Label="Admin password" Variant="Variant.Outlined"
                      InputType="InputType.Password" Required="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    private string _slug = "";
    private string _name = "";
    private string _country = "US";
    private string _currency = "USD";
    private string _timeZone = "UTC";
    private string _adminEmail = "";
    private string _adminName = "";
    private string _adminPassword = "";

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_slug) || string.IsNullOrWhiteSpace(_name)
            || string.IsNullOrWhiteSpace(_adminEmail) || string.IsNullOrWhiteSpace(_adminPassword)
            || string.IsNullOrWhiteSpace(_adminName)) return;
        MudDialog.Close(DialogResult.Ok(new CreateTenantRequest(
            _slug.Trim().ToLowerInvariant(), _name.Trim(),
            _country.Trim(), _currency.Trim(), _timeZone.Trim(),
            _adminEmail.Trim(), _adminName.Trim(), _adminPassword)));
    }
}
