@using Pos.Shared.Contracts

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_email" Label="Email" Variant="Variant.Outlined"
                      Required="true" Disabled="@(_isEdit)" Class="mb-3"
                      InputType="InputType.Email"
                      Validation="@(new Func<string, string?>(ValidateEmail))" />
        <MudTextField @bind-Value="_displayName" Label="Display name" Variant="Variant.Outlined" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_phone" Label="Phone" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_password"
                      Label="@(_isEdit ? "New password (leave blank to keep)" : "Password")"
                      Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-3"
                      HelperText="At least 8 characters"
                      Validation="@(new Func<string, string?>(ValidatePassword))" />
        <MudSelect T="Guid?" @bind-Value="_roleId" Label="Role" Variant="Variant.Outlined"
                   Required="true" Class="mb-3"
                   ToStringFunc="@(id => Roles.FirstOrDefault(r => r.Id == id)?.Name ?? "Select role…")">
            @foreach (var r in Roles)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)r.Id)">@r.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="Guid" @bind-SelectedValues="_selectedShops" MultiSelection="true"
                   Label="Shops" Variant="Variant.Outlined"
                   SelectAll="true" SelectAllText="Select all shops" Class="mb-3"
                   ToStringFunc="@(id => Shops.FirstOrDefault(s => s.Id == id)?.Name ?? id.ToString())">
            @foreach (var s in Shops)
            {
                <MudSelectItem T="Guid" Value="@s.Id">@s.Name (@s.Code)</MudSelectItem>
            }
        </MudSelect>
        <MudSwitch @bind-Value="_isActive" Color="Color.Success">Active</MudSwitch>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public UserDto? Existing { get; set; }
    [Parameter] public IReadOnlyList<ShopDto> Shops { get; set; } = Array.Empty<ShopDto>();
    [Parameter] public IReadOnlyList<RoleDto> Roles { get; set; } = Array.Empty<RoleDto>();

    private bool _isEdit;
    private string _email = "";
    private string _displayName = "";
    private string? _phone;
    private string _password = "";
    private bool _isActive = true;
    private Guid? _roleId;
    private IEnumerable<Guid> _selectedShops = Array.Empty<Guid>();

    protected override void OnInitialized()
    {
        if (Existing is not null)
        {
            _isEdit = true;
            _email = Existing.Email;
            _displayName = Existing.DisplayName;
            _phone = Existing.Phone;
            _isActive = Existing.IsActive;
            _roleId = Existing.RoleId;
            _selectedShops = Existing.ShopIds.ToList();
        }
        else
        {
            // Default new users to "Cashier" if available.
            _roleId = Roles.FirstOrDefault(r => string.Equals(r.Name, "Cashier", StringComparison.OrdinalIgnoreCase))?.Id
                      ?? Roles.FirstOrDefault()?.Id;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private static string? ValidateEmail(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) return "Email is required";
        try { _ = new System.Net.Mail.MailAddress(v.Trim()); return null; }
        catch { return "Enter a valid email address"; }
    }

    private string? ValidatePassword(string? v)
    {
        if (_isEdit && string.IsNullOrEmpty(v)) return null;
        if (string.IsNullOrEmpty(v)) return "Password is required";
        if (v.Length < 8) return "Password must be at least 8 characters";
        return null;
    }

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_displayName)) return;
        if (_roleId is null) return;
        var shopIds = _selectedShops.ToList();
        if (_isEdit)
        {
            if (!string.IsNullOrEmpty(_password) && _password.Length < 8) return;
            MudDialog.Close(DialogResult.Ok(new UpdateUserRequest(
                _displayName.Trim(), _phone, _isActive,
                string.IsNullOrWhiteSpace(_password) ? null : _password,
                _roleId, shopIds)));
        }
        else
        {
            if (ValidateEmail(_email) is not null) return;
            if (ValidatePassword(_password) is not null) return;
            MudDialog.Close(DialogResult.Ok(new CreateUserRequest(
                _email.Trim().ToLowerInvariant(), _displayName.Trim(), _phone, _password, _isActive,
                _roleId, shopIds)));
        }
    }
}
