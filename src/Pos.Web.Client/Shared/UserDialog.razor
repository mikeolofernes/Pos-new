@using Pos.Shared.Contracts

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_email" Label="Email" Variant="Variant.Outlined"
                      Required="true" Disabled="@(_isEdit)" Class="mb-3" />
        <MudTextField @bind-Value="_displayName" Label="Display name" Variant="Variant.Outlined" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="_phone" Label="Phone" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_password"
                      Label="@(_isEdit ? "New password (leave blank to keep)" : "Password")"
                      Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-3" />
        <MudSelect T="Guid" @bind-SelectedValues="_selectedShops" MultiSelection="true"
                   Label="Shops" Variant="Variant.Outlined"
                   SelectAll="true" SelectAllText="Select all shops" Class="mb-3"
                   ToStringFunc="@(id => Shops.FirstOrDefault(s => s.Id == id)?.Name ?? id.ToString())">
            @foreach (var s in Shops)
            {
                <MudSelectItem T="Guid" Value="@s.Id">@s.Name (@s.Code)</MudSelectItem>
            }
        </MudSelect>
        <MudSwitch @bind-Value="_isActive" Color="Color.Success">Active</MudSwitch>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public UserDto? Existing { get; set; }
    [Parameter] public IReadOnlyList<ShopDto> Shops { get; set; } = Array.Empty<ShopDto>();

    private bool _isEdit;
    private string _email = "";
    private string _displayName = "";
    private string? _phone;
    private string _password = "";
    private bool _isActive = true;
    private IEnumerable<Guid> _selectedShops = Array.Empty<Guid>();

    protected override void OnInitialized()
    {
        if (Existing is not null)
        {
            _isEdit = true;
            _email = Existing.Email;
            _displayName = Existing.DisplayName;
            _phone = Existing.Phone;
            _isActive = Existing.IsActive;
            _selectedShops = Existing.ShopIds.ToList();
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_displayName)) return;
        var shopIds = _selectedShops.ToList();
        if (_isEdit)
        {
            MudDialog.Close(DialogResult.Ok(new UpdateUserRequest(
                _displayName.Trim(), _phone, _isActive,
                string.IsNullOrWhiteSpace(_password) ? null : _password, shopIds)));
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password)) return;
            MudDialog.Close(DialogResult.Ok(new CreateUserRequest(
                _email.Trim(), _displayName.Trim(), _phone, _password, _isActive, shopIds)));
        }
    }
}
