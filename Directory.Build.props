<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!--
      Style/design code-analysis rules that we deliberately keep as warnings, not errors:
        CA1000 - Do not declare static members on generic types.
                 Result<T>.Success / .Failure factories are an established pattern.
        CA1716 - Identifiers should not match reserved VB.NET keywords.
                 'Error', 'Shared' etc. are fine for a C#-only codebase.
        CA1707 - Identifiers should not contain underscores (test method names).
        CA2007 - Consider calling ConfigureAwait (not relevant for ASP.NET Core/Blazor).
        CA1031 - Do not catch general exception types (we catch broadly in a few spots
                 like sync drain & UI handlers where bubbling would be worse UX).
        CA1062 - Validate arguments of public methods (overkill for internal records/DTOs).
        CA1812 - Avoid uninstantiated internal classes (false-positive on DI-registered types).
        CA1819 - Properties should not return arrays (DTOs use string[] for permissions).
    -->
    <WarningsNotAsErrors>CA1000;CA1716;CA1707;CA2007;CA1031;CA1062;CA1812;CA1819;CA1725;CA1816;CA1305;CA1848;CA1873;CA1304;CA1311;CA1822;CA1054;CA1056;CA2234</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
