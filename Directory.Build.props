<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!--
      Build policy:

      We do NOT use <TreatWarningsAsErrors>true</TreatWarningsAsErrors>, because
      the .NET 9 'latest-recommended' analyzer ruleset flags dozens of stylistic
      CA rules (CA1725 param naming, CA1816 GC.SuppressFinalize, CA1305 culture,
      CA1848 LoggerMessage, CA1861 array literals, CA1716 reserved keywords, ...).
      Those are useful hints but not bugs; treating them all as errors makes the
      project an exhausting game of whack-a-mole during initial scaffolding.

      Instead we whitelist the warnings we DO want to break the build:
        - Nullable reference type warnings (CS86xx) — real correctness bugs.
        - A few specific CA rules that catch real issues (security, dispose).

      Tighten this list over time as the codebase stabilises.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>
      nullable;
      CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;
      CA2100;CA2200;CA2208;CA2213;CA2215;CA2245;CA2249
    </WarningsAsErrors>

    <!-- Keep the analyzer noise out of the build summary's "0 Warning(s)" count. -->
    <NoWarn>$(NoWarn)</NoWarn>
  </PropertyGroup>
</Project>
